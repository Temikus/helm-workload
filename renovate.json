{
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image tags in values.yaml",
      "managerFilePatterns": [
        "/(^|/)values\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\\s\"']+)[\"']?[^\\n]*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update tool versions pinned in GitHub workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "pinDigests": false
    }
  ]
}
