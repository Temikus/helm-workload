should match generic snapshot:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        cert-manager.io/cluster-issuer: digitalocean-dns-production-issuer
        kubernetes.io/ingress.class: traefik
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: RELEASE-NAME-workload
    spec:
      rules:
        - host: workload-release-name.example.com
          http:
            paths:
              - backend:
                  service:
                    name: foo-RELEASE-NAME-workload
                    port:
                      number: 80
                path: /
                pathType: ImplementationSpecific
      tls:
        - hosts:
            - workload-release-name.example.com
          secretName: workload-release-name-tls
  2: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: foo-RELEASE-NAME-workload
    spec:
      ports:
        - name: foo
          port: 80
          protocol: TCP
          targetPort: foo
      selector:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: workload
      type: ClusterIP
  3: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: bar-RELEASE-NAME-workload
    spec:
      ports:
        - name: bar
          port: 443
          protocol: TCP
          targetPort: bar
      selector:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: workload
      type: ClusterIP
