{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["image"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "default": 1,
      "description": "Number of replicas to run"
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Docker image repository"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag (defaults to Chart appVersion if not set)"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent",
          "description": "Image pull policy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the secret containing docker registry credentials"
          }
        }
      },
      "default": []
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the name of the chart"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name of the chart"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether a service account should be created"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations to add to the service account"
        },
        "name": {
          "type": "string",
          "description": "The name of the service account to use (if not set and create is true, a name is generated)"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations to add to the pod"
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Security context for the pod"
    },
    "securityContext": {
      "type": "object",
      "description": "Security context for the containers"
    },
    "ports": {
      "type": ["array", "object"],
      "items": {
        "type": "object",
        "required": ["name", "port"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the port"
          },
          "port": {
            "type": "integer",
            "description": "Port number"
          },
          "protocol": {
            "type": "string",
            "enum": ["TCP", "UDP"],
            "default": "TCP",
            "description": "Protocol for the port"
          },
          "service": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable service for this port"
              },
              "port": {
                "type": "integer",
                "description": "Service port number (defaults to container port if not set)"
              },
              "name": {
                "type": "string",
                "description": "Service name"
              },
              "nameOverride": {
                "type": "string",
                "description": "Override the full service name"
              }
            }
          }
        }
      },
      "description": "Container ports configuration"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ingress"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Hostname"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Path"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"],
                      "description": "Path type"
                    },
                    "backend": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "object",
                          "required": ["name", "port"],
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Service name"
                            },
                            "port": {
                              "type": "object",
                              "required": ["number"],
                              "properties": {
                                "number": {
                                  "type": "integer",
                                  "description": "Service port number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "description": "TLS secret name"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "TLS hosts"
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable persistence"
        },
        "type": {
          "type": "string",
          "enum": ["pvc", "sts", "StatefulSet", "statefulset"],
          "description": "Type of persistence to use"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
          },
          "description": "Access modes for the persistent volume"
        },
        "size": {
          "type": "string",
          "description": "Size of the persistent volume"
        },
        "storageClassName": {
          "type": "string",
          "description": "Storage class name"
        },
        "mountPath": {
          "type": "string",
          "description": "Mount path in the container"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations for the PVC"
        },
        "selectorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Selector labels for the PVC"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "startupProbe": {
          "type": "object",
          "description": "Kubernetes startup probe configuration"
        },
        "livenessProbe": {
          "type": "object",
          "description": "Kubernetes liveness probe configuration"
        },
        "readinessProbe": {
          "type": "object",
          "description": "Kubernetes readiness probe configuration"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU limit"
            },
            "memory": {
              "type": "string",
              "description": "Memory limit"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU request"
            },
            "memory": {
              "type": "string",
              "description": "Memory request"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable horizontal pod autoscaling"
        },
        "minReplicas": {
          "type": "integer",
          "default": 1,
          "description": "Minimum number of replicas"
        },
        "maxReplicas": {
          "type": "integer",
          "default": 100,
          "description": "Maximum number of replicas"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "default": 80,
          "description": "Target CPU utilization percentage"
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "description": "Target memory utilization percentage"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector labels"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pod tolerations"
    },
    "affinity": {
      "type": "object",
      "description": "Pod affinity rules"
    },
    "env": {
      "type": "object",
      "description": "Environment variables"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Container command override"
    },
    "hostNetwork": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable host network"
        }
      }
    },
    "volumes": {
      "type": "object",
      "properties": {
        "host": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "containerPath"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Volume name"
              },
              "containerPath": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path to mount in container"
                  }
                }
              }
            }
          }
        }
      }
    },
    "addons": {
      "type": "object",
      "properties": {
        "vpn": {
          "type": "object",
          "description": "VPN sidecar configuration (see hwl chart schema for details)",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}