{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["image"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "default": 1,
      "description": "Number of replicas to run"
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Docker image repository"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag (defaults to Chart appVersion if not set)"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent",
          "description": "Image pull policy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the secret containing docker registry credentials"
          }
        }
      },
      "default": []
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the name of the chart"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name of the chart"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether a service account should be created"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations to add to the service account"
        },
        "name": {
          "type": "string",
          "description": "The name of the service account to use (if not set and create is true, a name is generated)"
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations to add to the Deployment/StatefulSet object (not the pod template)"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations to add to the pod"
    },
    "secretEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variables rendered into a chart-owned Secret (same shape as env)"
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": { "type": "string" },
          "secretRef": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          },
          "configMapRef": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          }
        }
      },
      "description": "Extra envFrom entries appended after chart-generated ConfigMap/Secret refs"
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Security context for the pod"
    },
    "securityContext": {
      "type": "object",
      "description": "Security context for the containers"
    },
    "ports": {
      "type": ["array", "object"],
      "items": {
        "type": "object",
        "required": ["name", "port"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the port"
          },
          "port": {
            "type": "integer",
            "description": "Port number"
          },
          "protocol": {
            "type": "string",
            "enum": ["TCP", "UDP"],
            "default": "TCP",
            "description": "Protocol for the port"
          },
          "service": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable service for this port"
              },
              "port": {
                "type": "integer",
                "description": "Service port number (defaults to container port if not set)"
              },
              "name": {
                "type": "string",
                "description": "Service name"
              },
              "nameOverride": {
                "type": "string",
                "description": "Override the full service name"
              }
            }
          }
        }
      },
      "description": "Container ports configuration"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ingress"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Hostname"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Path"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"],
                      "description": "Path type"
                    },
                    "backend": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "object",
                          "required": ["name", "port"],
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Service name"
                            },
                            "port": {
                              "type": "object",
                              "required": ["number"],
                              "properties": {
                                "number": {
                                  "type": "integer",
                                  "description": "Service port number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "description": "TLS secret name"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "TLS hosts"
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable persistence storage"
        },
        "type": {
          "type": "string",
          "enum": ["pvc", "sts", "StatefulSet", "statefulset"],
          "description": "Type of persistence to use"
        },
        "size": {
          "type": "string",
          "description": "Size of persistent volume claim"
        },
        "storageClassName": {
          "type": "string",
          "description": "Storage class to use for the PVC"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
          },
          "description": "Access modes for the PVC"
        },
        "selectorLabels": {
          "type": "object",
          "description": "Selector labels for the PVC"
        },
        "mountPath": {
          "type": "string",
          "description": "Path to mount the volume"
        },
        "subPath": {
          "type": "string",
          "description": "Sub-path inside the volume"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations for the PVC"
        },
        "extraVolumes": {
          "type": "array",
          "description": "Additional volumes to attach to the statefulset",
          "items": {
            "type": "object",
            "required": ["name", "size", "mountPath"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the volume"
              },
              "size": {
                "type": "string",
                "description": "Size of the volume"
              },
              "mountPath": {
                "type": "string",
                "description": "Path to mount the volume"
              },
              "storageClassName": {
                "type": "string",
                "description": "Storage class to use for the volume"
              },
              "accessModes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
                },
                "description": "Access modes for the volume"
              },
              "labels": {
                "type": "object",
                "description": "Labels for the volume"
              },
              "annotations": {
                "type": "object",
                "description": "Annotations for the volume"
              },
              "selectorLabels": {
                "type": "object",
                "description": "Selector labels for the volume"
              },
              "subPath": {
                "type": "string",
                "description": "Sub-path inside the volume"
              },
              "readOnly": {
                "type": "boolean",
                "description": "Mount volume as read-only"
              }
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "startupProbe": {
          "type": "object",
          "description": "Kubernetes startup probe configuration"
        },
        "livenessProbe": {
          "type": "object",
          "description": "Kubernetes liveness probe configuration"
        },
        "readinessProbe": {
          "type": "object",
          "description": "Kubernetes readiness probe configuration"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU limit"
            },
            "memory": {
              "type": "string",
              "description": "Memory limit"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU request"
            },
            "memory": {
              "type": "string",
              "description": "Memory request"
            }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "description": "Rollout strategy for Deployment (strategy) or StatefulSet (updateStrategy)",
      "properties": {
        "type": {
          "type": "string",
          "description": "Strategy type (RollingUpdate, Recreate for Deployment; RollingUpdate, OnDelete for StatefulSet)"
        },
        "rollingUpdate": {
          "type": "object",
          "description": "Rolling update configuration",
          "properties": {
            "maxUnavailable": {
              "description": "Maximum number of pods that can be unavailable during the update"
            },
            "maxSurge": {
              "description": "Maximum number of pods that can be created above the desired number (Deployment only)"
            },
            "partition": {
              "type": "integer",
              "description": "Ordinal at which to partition the StatefulSet update (StatefulSet only)"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable horizontal pod autoscaling"
        },
        "minReplicas": {
          "type": "integer",
          "default": 1,
          "description": "Minimum number of replicas"
        },
        "maxReplicas": {
          "type": "integer",
          "default": 100,
          "description": "Maximum number of replicas"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "default": 80,
          "description": "Target CPU utilization percentage"
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "description": "Target memory utilization percentage"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector labels"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pod tolerations"
    },
    "affinity": {
      "type": "object",
      "description": "Pod affinity rules"
    },
    "env": {
      "type": "object",
      "description": "Environment variables"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Container command override"
    },
    "hostNetwork": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable host network"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "description": "NetworkPolicy configuration for restricting ingress traffic to the pod",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Create a NetworkPolicy for the workload"
        },
        "allowPortsIngress": {
          "type": "boolean",
          "default": true,
          "description": "Automatically allow ingress on all ports from .Values.ports. Ignored when explicit ingress rules are provided."
        },
        "ingress": {
          "type": "array",
          "default": [],
          "description": "Explicit ingress rules. Each rule can specify ports and from (namespaceSelector/podSelector).",
          "items": {
            "type": "object",
            "properties": {
              "ports": {
                "type": "array",
                "description": "Ports to allow in this rule",
                "items": {
                  "type": "object",
                  "required": ["port"],
                  "properties": {
                    "port": {
                      "type": ["integer", "string"],
                      "description": "Port number or name"
                    },
                    "protocol": {
                      "type": "string",
                      "enum": ["TCP", "UDP", "SCTP"],
                      "default": "TCP",
                      "description": "Protocol for the port"
                    }
                  }
                }
              },
              "from": {
                "type": "array",
                "description": "Sources allowed to access the ports (namespaceSelector, podSelector, ipBlock)",
                "items": {
                  "type": "object",
                  "properties": {
                    "namespaceSelector": {
                      "type": "object",
                      "description": "Namespace selector for allowed sources"
                    },
                    "podSelector": {
                      "type": "object",
                      "description": "Pod selector for allowed sources"
                    },
                    "ipBlock": {
                      "type": "object",
                      "description": "IP block for allowed sources",
                      "properties": {
                        "cidr": {
                          "type": "string",
                          "description": "CIDR range"
                        },
                        "except": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "CIDRs to exclude"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "volumes": {
      "type": "object",
      "properties": {
        "host": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "containerPath"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Volume name"
              },
              "containerPath": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path to mount in container"
                  }
                }
              }
            }
          }
        }
      }
    },
    "extraContainers": {
      "type": "array",
      "description": "Additional sidecar containers to add to the pod",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Container name"
          },
          "image": {
            "type": "string",
            "description": "Container image"
          }
        }
      }
    },
    "extraServices": {
      "type": "array",
      "description": "Additional multi-port Service resources to create alongside port-derived services",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "ports"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Service name (appended to release fullname)"
          },
          "type": {
            "type": "string",
            "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
            "default": "ClusterIP",
            "description": "Service type"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Annotations to add to the service"
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "port"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Port name"
                },
                "port": {
                  "type": "integer",
                  "description": "Service port number"
                },
                "targetPort": {
                  "type": ["integer", "string"],
                  "description": "Target port on the container (name or number, defaults to port name)"
                },
                "protocol": {
                  "type": "string",
                  "enum": ["TCP", "UDP"],
                  "default": "TCP",
                  "description": "Protocol for the port"
                }
              }
            }
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "description": "Additional volumes to add to the pod",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Volume name"
          }
        }
      }
    },
    "addons": {
      "type": "object",
      "required": ["vpn", "init"],
      "properties": {
        "init": {
          "type": "object",
          "required": ["enabled", "image"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable init container"
            },
            "image": {
              "type": "object",
              "required": ["repository", "tag"],
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Init container image repository"
                },
                "tag": {
                  "type": "string",
                  "description": "Init container image tag"
                },
                "pullPolicy": {
                  "type": "string",
                  "default": "IfNotPresent",
                  "enum": ["Always", "IfNotPresent", "Never"],
                  "description": "Image pull policy"
                }
              }
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Command to run in the init container"
            },
            "securityContext": {
              "type": "object",
              "description": "Security context for the init container"
            },
            "volumeMounts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "mountPath"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Volume name"
                  },
                  "mountPath": {
                    "type": "string",
                    "description": "Path to mount volume"
                  },
                  "subPath": {
                    "type": "string",
                    "description": "Sub-path inside the volume"
                  }
                }
              },
              "description": "Volume mounts for the init container"
            }
          }
        },
        "vpn": {
          "type": "object",
          "required": [
            "enabled",
            "image",
            "provider",
            "openvpn",
            "wireguard",
            "config",
            "portForward",
            "persistence"
          ],
          "properties": {
            "firewall": {
              "type": "object",
              "description": "Firewall configuration for VPN"
            },
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable VPN sidecar container"
            },
            "image": {
              "type": "object",
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": {
                  "type": "string",
                  "default": "ghcr.io/qdm12/gluetun",
                  "description": "Gluetun image repository"
                },
                "tag": {
                  "type": "string",
                  "default": "latest",
                  "description": "Gluetun image tag"
                },
                "pullPolicy": {
                  "type": "string",
                  "default": "Always",
                  "enum": ["Always", "IfNotPresent", "Never"],
                  "description": "Image pull policy"
                }
              }
            },
            "provider": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "VPN provider name"
                },
                "type": {
                  "type": "string",
                  "enum": ["openvpn", "wireguard"],
                  "description": "VPN connection type"
                }
              }
            },
            "openvpn": {
              "type": "object",
              "properties": {
                "auth": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string",
                      "description": "OpenVPN username"
                    },
                    "password": {
                      "type": "string",
                      "description": "OpenVPN password"
                    },
                    "existingSecret": {
                      "type": "string",
                      "description": "Name of existing secret containing OpenVPN credentials"
                    },
                    "existingSecretUsernameKey": {
                      "type": "string",
                      "default": "username",
                      "description": "Key in existing secret for username"
                    },
                    "existingSecretPasswordKey": {
                      "type": "string",
                      "default": "password",
                      "description": "Key in existing secret for password"
                    }
                  }
                }
              }
            },
            "wireguard": {
              "type": "object",
              "properties": {
                "privateKey": {
                  "type": "string",
                  "description": "WireGuard private key"
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "WireGuard addresses"
                },
                "existingSecret": {
                  "type": "string",
                  "description": "Name of existing secret containing WireGuard private key"
                }
              }
            },
            "config": {
              "type": "object",
              "required": ["timezone", "serverSelection"],
              "properties": {
                "timezone": {
                  "type": "string",
                  "default": "UTC",
                  "description": "Container timezone"
                },
                "serverSelection": {
                  "type": "object",
                  "properties": {
                    "countries": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of countries for server selection"
                    },
                    "cities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of cities for server selection"
                    },
                    "hostnames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of hostnames for server selection"
                    }
                  }
                }
              }
            },
            "portForward": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable port forwarding"
                }
              }
            },
            "persistence": {
              "type": "object",
              "required": ["enabled", "size"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable persistence for VPN configuration"
                },
                "size": {
                  "type": "string",
                  "default": "1Gi",
                  "description": "Size of persistent volume claim"
                },
                "existingClaim": {
                  "type": "string",
                  "description": "Name of existing PVC"
                }
              }
            },
            "shareProcessNamespace": {
              "type": "boolean",
              "default": false,
              "description": "Share process namespace with the main container"
            }
          }
        },
        "cloudflareTunnel": {
          "type": "object",
          "description": "Cloudflare Tunnel addon - creates Tunnel/ClusterTunnel and TunnelBinding resources via cloudflare-operator",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable Cloudflare Tunnel addon"
            },
            "fqdn": {
              "type": "string",
              "description": "FQDN that Cloudflare will route to this service (required when enabled)"
            },
            "protocol": {
              "type": "string",
              "enum": ["http", "https", "tcp"],
              "default": "http",
              "description": "Protocol for the tunnel binding"
            },
            "targetPort": {
              "type": ["integer", "string"],
              "description": "Target port on the service to route traffic to (required when enabled)"
            },
            "pathFilter": {
              "type": "object",
              "description": "Path filter restricts which paths are exposed through the tunnel using an nginx sidecar proxy",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable path filtering via nginx sidecar proxy"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^/[a-zA-Z0-9/_.-]*$"
                  },
                  "description": "List of paths to allow through the tunnel (e.g., ['/webhook', '/api/v1']). Only alphanumeric characters, slashes, underscores, dots, and hyphens are allowed."
                },
                "port": {
                  "type": "integer",
                  "default": 8880,
                  "description": "Port the nginx path-filter proxy listens on"
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "default": "nginx",
                      "description": "Nginx image repository"
                    },
                    "tag": {
                      "type": "string",
                      "default": "alpine",
                      "description": "Nginx image tag"
                    }
                  }
                }
              }
            },
            "serviceName": {
              "type": "string",
              "description": "Override the service name targeted by the tunnel (defaults to release fullname)"
            },
            "caPool": {
              "type": "string",
              "description": "CA certificate name in the tunnel's originCaPool to trust for TLS backends"
            },
            "noTlsVerify": {
              "type": "boolean",
              "default": false,
              "description": "Disable TLS verification to backend service"
            },
            "tunnelRef": {
              "type": "object",
              "description": "Reference to an existing Tunnel or ClusterTunnel (used when tunnel.create is false)",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["Tunnel", "ClusterTunnel"],
                  "default": "ClusterTunnel",
                  "description": "Kind of the tunnel resource to reference"
                },
                "name": {
                  "type": "string",
                  "description": "Name of the existing tunnel resource (required when tunnel.create is false)"
                },
                "disableDNSUpdates": {
                  "type": "boolean",
                  "default": false,
                  "description": "Disable automatic DNS record updates by the controller"
                }
              }
            },
            "tunnel": {
              "type": "object",
              "description": "Configuration for creating a new Tunnel/ClusterTunnel resource",
              "properties": {
                "create": {
                  "type": "boolean",
                  "default": false,
                  "description": "Create a new Tunnel/ClusterTunnel resource"
                },
                "kind": {
                  "type": "string",
                  "enum": ["Tunnel", "ClusterTunnel"],
                  "default": "ClusterTunnel",
                  "description": "Kind of the tunnel resource to create"
                },
                "name": {
                  "type": "string",
                  "description": "Name for the new tunnel (defaults to release-fullname-tunnel)"
                },
                "fallbackTarget": {
                  "type": "string",
                  "default": "http_status:404",
                  "description": "Default service to point cloudflared to when no route matches"
                },
                "noTlsVerify": {
                  "type": "boolean",
                  "default": false,
                  "description": "Disable TLS verification to backend services globally"
                },
                "cloudflare": {
                  "type": "object",
                  "description": "Cloudflare account configuration",
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "description": "Cloudflare account ID (required when tunnel.create is true)"
                    },
                    "domain": {
                      "type": "string",
                      "description": "Domain where the tunnel runs (required when tunnel.create is true)"
                    },
                    "email": {
                      "type": "string",
                      "description": "Email address for Cloudflare login (required when tunnel.create is true)"
                    },
                    "credentials": {
                      "type": "object",
                      "description": "Cloudflare API credentials. Provide either existingSecret to reference a pre-created Secret, or apiToken/apiKey to have the chart create one.",
                      "properties": {
                        "existingSecret": {
                          "type": "string",
                          "description": "Name of an existing Kubernetes Secret containing Cloudflare API credentials. When set, no Secret is created by the chart."
                        },
                        "apiToken": {
                          "type": "string",
                          "description": "Cloudflare API Token (recommended). A Secret will be created containing this value. Ignored if existingSecret is set."
                        },
                        "apiKey": {
                          "type": "string",
                          "description": "Cloudflare Global API Key (not recommended). A Secret will be created containing this value. Ignored if existingSecret is set."
                        }
                      }
                    }
                  }
                }
              }
            },
            "networkPolicy": {
              "type": "object",
              "description": "Optional NetworkPolicy restricting ingress to only the tunnel-bound port",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Create a NetworkPolicy that only allows ingress on the tunnel-bound port"
                }
              }
            }
          }
        },
        "postgres": {
          "type": "object",
          "description": "PostgreSQL addon - deploys a separate Deployment and Service for PostgreSQL",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable PostgreSQL deployment"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "default": "postgres",
                  "description": "PostgreSQL image repository"
                },
                "tag": {
                  "type": "string",
                  "default": "15-alpine",
                  "description": "PostgreSQL image tag"
                },
                "pullPolicy": {
                  "type": "string",
                  "default": "IfNotPresent",
                  "enum": ["Always", "IfNotPresent", "Never"],
                  "description": "Image pull policy"
                }
              }
            },
            "auth": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "default": "postgres",
                  "description": "PostgreSQL username"
                },
                "password": {
                  "type": "string",
                  "description": "PostgreSQL password"
                },
                "database": {
                  "type": "string",
                  "default": "postgres",
                  "description": "PostgreSQL database name"
                },
                "existingSecret": {
                  "type": "string",
                  "description": "Name of existing secret containing PostgreSQL credentials"
                },
                "existingSecretKey": {
                  "type": "string",
                  "description": "Key in existing secret for password"
                }
              }
            },
            "service": {
              "type": "object",
              "description": "Service configuration for PostgreSQL",
              "properties": {
                "port": {
                  "type": "integer",
                  "default": 5432,
                  "description": "Service port for PostgreSQL"
                },
                "type": {
                  "type": "string",
                  "default": "ClusterIP",
                  "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
                  "description": "Service type for PostgreSQL"
                }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "description": "CPU limit"
                    },
                    "memory": {
                      "type": "string",
                      "description": "Memory limit"
                    }
                  }
                },
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "description": "CPU request"
                    },
                    "memory": {
                      "type": "string",
                      "description": "Memory request"
                    }
                  }
                }
              }
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable persistence for PostgreSQL data"
                },
                "size": {
                  "type": "string",
                  "default": "8Gi",
                  "description": "Size of persistent volume claim"
                },
                "existingClaim": {
                  "type": "string",
                  "description": "Name of existing PVC"
                },
                "storageClass": {
                  "type": "string",
                  "description": "Storage class name"
                },
                "accessMode": {
                  "type": "string",
                  "default": "ReadWriteOnce",
                  "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"],
                  "description": "Access mode for the PVC"
                },
                "subPath": {
                  "type": "string",
                  "default": "data",
                  "description": "Sub-path inside the volume"
                }
              }
            },
            "livenessProbe": {
              "type": "object",
              "description": "Custom liveness probe configuration"
            },
            "readinessProbe": {
              "type": "object",
              "description": "Custom readiness probe configuration"
            },
            "additionalEnv": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Additional environment variables"
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Node selector for the PostgreSQL pod"
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Tolerations for the PostgreSQL pod"
            },
            "affinity": {
              "type": "object",
              "description": "Affinity rules for the PostgreSQL pod"
            }
          }
        },
        "infisical": {
          "type": "object",
          "description": "Infisical secrets-operator addon - renders an InfisicalSecret CR and injects the managed Secret via envFrom",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable the Infisical addon"
            },
            "hostAPI": {
              "type": "string",
              "default": "",
              "description": "Self-hosted Infisical API URL (e.g. https://infisical.example.com/api). Empty for Infisical Cloud"
            },
            "projectSlug": {
              "type": "string",
              "description": "Infisical project slug (required when enabled)"
            },
            "envSlug": {
              "type": "string",
              "description": "Infisical environment slug (required when enabled)"
            },
            "secretsPath": {
              "type": "string",
              "default": "/",
              "description": "Secrets folder path to sync"
            },
            "recursive": {
              "type": "boolean",
              "default": false,
              "description": "Include secrets from subfolders"
            },
            "credentialsSecret": {
              "type": "string",
              "default": "infisical-universal-auth",
              "description": "Name of the universal-auth credentials Secret (keys: clientId, clientSecret)"
            },
            "credentialsSecretNamespace": {
              "type": "string",
              "default": "",
              "description": "Namespace of the credentials Secret (defaults to the release namespace)"
            },
            "resyncInterval": {
              "type": "integer",
              "minimum": 5,
              "default": 60,
              "description": "Operator resync interval in seconds"
            },
            "includeAllSecrets": {
              "type": "boolean",
              "default": true,
              "description": "Sync every secret under secretsPath into the managed Secret"
            },
            "keys": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Rename map ENV_NAME: INFISICAL_KEY rendered into the managed Secret template"
            },
            "managedSecretName": {
              "type": "string",
              "default": "",
              "description": "Managed Secret name (defaults to {fullname}-infisical)"
            },
            "creationPolicy": {
              "type": "string",
              "enum": ["Owner", "Orphan"],
              "default": "Owner",
              "description": "Managed Secret ownership policy"
            },
            "injectEnvFrom": {
              "type": "boolean",
              "default": true,
              "description": "Add the managed Secret to the main container's envFrom"
            },
            "autoReload": {
              "type": "boolean",
              "default": true,
              "description": "Set secrets.infisical.com/auto-reload on the workload so the operator restarts it on secret change"
            }
          }
        }
      }
    }
  }
}
