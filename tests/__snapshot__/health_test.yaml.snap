                tcpSocket:
                  port: 80
              name: workload
              ports: null
              readinessProbe:
                initialDelaySeconds: 30
                periodSeconds: 10
                tcpSocket:
                  port: 80
              resources: {}
              securityContext: {}
              volumeMounts: null
          securityContext: {}
          serviceAccountName: RELEASE-NAME-workload
should configure all probes correctly:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: RELEASE-NAME-workload
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: workload
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: workload
        spec:
          containers:
            - image: nginx:0.3.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 6
                initialDelaySeconds: 60
                periodSeconds: 10
                timeoutSeconds: 5
              name: workload
              ports: null
              readinessProbe:
                failureThreshold: 6
                initialDelaySeconds: 30
                periodSeconds: 10
                timeoutSeconds: 5
              resources: {}
              securityContext: {}
              startupProbe:
                failureThreshold: 6
                initialDelaySeconds: 30
                periodSeconds: 10
                timeoutSeconds: 5
              volumeMounts: null
          securityContext: {}
          serviceAccountName: RELEASE-NAME-workload
should configure exec probes:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: RELEASE-NAME-workload
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: workload
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: workload
        spec:
          containers:
            - image: nginx:0.3.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - cat
                    - /tmp/healthy
                initialDelaySeconds: 30
                periodSeconds: 10
              name: workload
              ports: null
              readinessProbe:
                exec:
                  command:
                    - cat
                    - /tmp/ready
                initialDelaySeconds: 30
                periodSeconds: 10
              resources: {}
              securityContext: {}
              volumeMounts: null
          securityContext: {}
          serviceAccountName: RELEASE-NAME-workload
