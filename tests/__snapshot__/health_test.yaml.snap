should configure HTTP probes:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: workload
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: workload-0.3.0
      name: RELEASE-NAME-workload
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: workload
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: workload
        spec:
          containers:
            - image: nginx:0.3.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 6
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 30
                periodSeconds: 10
                timeoutSeconds: 5
              name: workload
              ports: null
              readinessProbe:
                httpGet:
                  path: /ready
                  port: http
                initialDelaySeconds: 30
                periodSeconds: 10
              resources: {}
              securityContext: {}
              volumeMounts: null
          securityContext: {}
          serviceAccountName: RELEASE-NAME-workload
