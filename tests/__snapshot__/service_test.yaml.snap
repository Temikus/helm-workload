should match basic snapshot:
  1: |
    replicas: 1
    selector:
      matchLabels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: workload
    template:
      metadata:
        annotations:
          kubectl.kubernetes.io/default-container: workload
        labels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: workload
      spec:
        containers:
          - image: nginx:test
            imagePullPolicy: IfNotPresent
            name: workload
            ports:
              - containerPort: 80
                name: foo
              - containerPort: 443
                name: bar
              - containerPort: 8080
                name: baz
            resources: {}
            securityContext: {}
            volumeMounts: null
        securityContext: {}
        serviceAccountName: RELEASE-NAME-workload
  2: |
    ports:
      - name: foo
        port: 80
        protocol: TCP
        targetPort: foo
    selector:
      app.kubernetes.io/instance: RELEASE-NAME
      app.kubernetes.io/name: workload
    type: ClusterIP
  3: |
    ports:
      - name: bar
        port: 443
        protocol: TCP
        targetPort: bar
    selector:
      app.kubernetes.io/instance: RELEASE-NAME
      app.kubernetes.io/name: workload
    type: ClusterIP
  4: |
    ports:
      - name: baz
        port: 8080
        protocol: TCP
        targetPort: baz
    selector:
      app.kubernetes.io/instance: RELEASE-NAME
      app.kubernetes.io/name: workload
    type: ClusterIP
